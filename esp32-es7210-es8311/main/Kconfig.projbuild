menu "ESP32 ES7210 + ES8311 AEC"

menuconfig USE_AUDIO_PROCESSOR
    bool "Enable Audio Noise Reduction"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    help
        Requires ESP32 S3 and PSRAM. Press Enter to open sub-options (device-side AEC).

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default y
    depends on USE_AUDIO_PROCESSOR
    help
        Sub-option of noise reduction / AFE. Needs a usable playback reference (e.g. ES7210 reference channel)
        and reasonable mic/speaker layout.


config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine


endmenu
